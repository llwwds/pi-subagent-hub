#!/usr/bin/env bash
# Native pi-subagent-hub 3.0 launcher.
#
# The default `pihub` command is Rust. This launcher only locates an existing
# build; it never falls back to the legacy Node implementation and never
# installs a toolchain or modifies PATH.
#
# Resolution order:
#   1. PIHUB_RUST_BIN (explicit path)
#   2. $CARGO_TARGET_DIR/release/pihub
#   3. ${TMPDIR:-/tmp}/pihub-rust-target/release/pihub
#   4. <repo>/rust/target/release/pihub and <repo>/target/release/pihub
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP_BASE="${TMPDIR:-/tmp}"
TMP_BASE="${TMP_BASE%/}"

# The launcher is the only component that knows the real repository root. An
# out-of-tree build (CARGO_TARGET_DIR=/tmp/...) otherwise leaves the binary with
# no `vendor/pi.lock.json` above it, so it would derive appRoot from
# `/tmp/<target>/release` and report bogus pi-lock/pi-commit/vendor paths.
#
# An explicit PIHUB_APP_ROOT always wins; when it is unset the launcher passes
# REPO_ROOT unconditionally. The app root does not depend on whether `vendor/`
# has been downloaded: a missing vendor must be reported as a missing item at
# the correct root, never masked by falling back to the binary's parent
# directory. PIHUB_HOME is never set or changed here, cwd is never guessed and
# nothing device-specific is hardcoded.
launch() {
  local binary="$1"
  shift
  export PIHUB_APP_ROOT="${PIHUB_APP_ROOT:-$REPO_ROOT}"
  exec "$binary" "$@"
}

if [[ -n "${PIHUB_RUST_BIN:-}" ]]; then
  if [[ ! -x "$PIHUB_RUST_BIN" ]]; then
    cat >&2 <<EOF
pi-subagent-hub 3.0 native binary was not found at PIHUB_RUST_BIN=$PIHUB_RUST_BIN
Build it with: bash rust/scripts/build-release.sh
This launcher never falls back to the legacy Node 2.1 entry.
EOF
    exit 1
  fi
  launch "$PIHUB_RUST_BIN" "$@"
fi

candidates=()
if [[ -n "${CARGO_TARGET_DIR:-}" ]]; then
  candidates+=("$CARGO_TARGET_DIR/release/pihub")
fi
candidates+=(
  "$TMP_BASE/pihub-rust-target/release/pihub"
  "$REPO_ROOT/rust/target/release/pihub"
  "$REPO_ROOT/target/release/pihub"
)

BIN=""
for candidate in "${candidates[@]}"; do
  if [[ -n "$candidate" && -x "$candidate" ]]; then
    BIN="$candidate"
    break
  fi
done

if [[ -z "$BIN" ]]; then
  cat >&2 <<'EOF'
pi-subagent-hub 3.0 native binary was not found.

Build it with the existing Cargo installation (no global install/PATH change):
  cd <repo>
  CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${TMPDIR:-/tmp}/pihub-rust-target}" \
    bash rust/scripts/build-release.sh

Then run either:
  PIHUB_RUST_BIN="${CARGO_TARGET_DIR:-${TMPDIR:-/tmp}/pihub-rust-target}/release/pihub" ./bin/pihub --version
or:
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${TMPDIR:-/tmp}/pihub-rust-target}"
  ./bin/pihub --version

The legacy Node 2.1 entry is explicit and separate: ./bin/pihub-legacy or
`npm run legacy`. This launcher never falls back to it.
EOF
  exit 1
fi

launch "$BIN" "$@"
